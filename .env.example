# 运行 python3.12 scripts/init_env.py 生成仅保存在本地的随机配置；不直接复制占位值启动。
COMPOSE_PROJECT_NAME=chat-rag
WEB_PORT=8080
MYSQL_DATABASE=chat_rag
MYSQL_USER=chat_rag
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3307
QDRANT_PORT=6333
QDRANT_API_KEY=
# 本机开发地址；Compose 内部会根据上面的变量使用 mysql/qdrant 服务名。
DATABASE_URL=mysql+asyncmy://chat_rag:REPLACE_WITH_GENERATED_PASSWORD@127.0.0.1:3307/chat_rag?charset=utf8mb4
QDRANT_URL=http://127.0.0.1:6333
HEALTH_TIMEOUT_SECONDS=3
AUTH_SECRET=
AUTH_TOKEN_TTL_SECONDS=1800
# 阶段 2 的已有配置可通过 scripts/init_env.py --upgrade 仅补齐认证配置。
# 阶段 4/5 再增加真实 Embedding/LLM 配置。
# 当前无需模型密钥，RAG 能力明确不可用。

