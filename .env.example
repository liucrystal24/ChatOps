# 运行 python3.12 scripts/init_env.py 生成仅保存在本地的随机配置；不直接复制占位值启动。
COMPOSE_PROJECT_NAME=chat-rag
WEB_PORT=8080
MYSQL_DATABASE=chat_rag
MYSQL_USER=chat_rag
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3307
QDRANT_PORT=6333
QDRANT_API_KEY=
# 本机开发地址；Compose 内部会根据上面的变量使用 mysql/qdrant 服务名。
DATABASE_URL=mysql+asyncmy://chat_rag:REPLACE_WITH_GENERATED_PASSWORD@127.0.0.1:3307/chat_rag?charset=utf8mb4
QDRANT_URL=http://127.0.0.1:6333
HEALTH_TIMEOUT_SECONDS=3
AUTH_SECRET=
AUTH_TOKEN_TTL_SECONDS=1800
# 阶段 2 的已有配置可通过 scripts/init_env.py --upgrade 仅补齐认证配置。
# 云端非 Pro BAAI/bge-m3 与 Qwen3-8B 共用 Key；密钥不得进入前端。
SILICONFLOW_API_KEY=
EMBEDDING_BATCH_SIZE=8
EMBEDDING_TIMEOUT_SECONDS=30

# 问答沿用同一 Key，固定云端非 Pro Qwen3-8B，不需要本地模型权重。
CHAT_MODEL=Qwen/Qwen3-8B
CHAT_DEADLINE_SECONDS=120
CHAT_OUTPUT_TOKENS=1024

# 段落/列表项切分；旧索引需手动重建后采用新配置。
CHUNK_STRUCTURE=paragraph-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=120
# 标题向量实验未带来额外开发集收益，默认关闭。
EMBEDDING_TITLE_CONTEXT=false
